# ==============================================================================
# Akademi Topluluk Asistanı — ortam değişkenleri
# Kaynak: packages/settings.py (Settings)
# Proje kökünde .env dosyası oluşturup bu dosyayı kopyalayın ve değerleri doldurun.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL (postgresql+asyncpg — packages/database/manager.py)
# Docker Compose: postgres + uygulama konteynerleri aynı şifreyi kullanmalı (ör. postgres).
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=slack_community_agent
# docker compose: Postgres’i makineye hangi porttan açacağı (varsayılan 5432). Yerel başka Postgres ile çakışırsa örn. 5433.
# POSTGRES_PUBLISH_PORT=5432

# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_PRE_PING=true
# DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# Slack (slack_bolt + Socket Mode — packages/slack/client.py)
# ------------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-senin-bot-token-buraya
SLACK_APP_TOKEN=xapp-senin-app-token-buraya
SLACK_USER_TOKEN=xoxp-senin-user-token-buraya

# ------------------------------------------------------------------------------
# LLM API Keys (LLM tabanlı analizler için)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk-senin-anahtarin-buraya
# GROQ_MODEL=llama-3.3-70b-versatile
HF_TOKEN=hf_senin_anahtarin_buraya

# Virgülle ayrılmış Slack kullanıcı ID'leri (workspace owner)
SLACK_WORKSPACE_OWNER_ID=U0123456789
# Slack kullanıcı ID’leri — virgülle çoklu admin (ilk ID tek kullanıcı bekleyen API çağrılarında kullanılır).
# Eski isim: SLACK_ADMIN_SLACK_ID (hâlâ okunur; yalnızca SLACK_ADMINS kullanmanız önerilir)
SLACK_ADMINS=U0123456789
# Admin bildirim kanalı; challenge kanalı (kanal ID: C...)
SLACK_ADMIN_CHANNEL=C0123456789
# Tüm etkinlik duyuruları bu kanala (boşsa EVENT_CHANNEL + etkinlik Slack kanalı kullanılır)
# SLACK_ANNOUNCEMENT_CHANNEL=C02LAJFKEFQ
SLACK_CHALLENGE_CHANNEL=C0123456789

# ------------------------------------------------------------------------------
# Monitör aralıkları (saniye) — isteğe bağlı
# ------------------------------------------------------------------------------
# MONITOR_CHALLENGE_INTERVAL=60
# MONITOR_DEADLINE_INTERVAL=300
# MONITOR_EVALUATION_INTERVAL=600
# Takım kurulumu beklemede (pending) kayıt TTL — dakika (ChallengeMonitor)
# PENDING_CHALLENGE_TTL_MINUTES=30

# ------------------------------------------------------------------------------
# Challenge / değerlendirme limitleri — isteğe bağlı
# ------------------------------------------------------------------------------
# CHALLENGE_MIN_PARTICIPANTS=2
# CHALLENGE_MAX_PARTICIPANTS=5
# EVALUATION_MAX_WAIT_HOURS=24
# EVALUATION_JURY_COUNT=2

# ------------------------------------------------------------------------------
# SMTP (isteğe bağlı — ikisini birden doldurun veya ikisini de boş bırakın)
# ------------------------------------------------------------------------------
# SMTP_EMAIL=
# SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TIMEOUT=30

